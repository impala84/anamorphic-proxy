{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeProxy",
  "version": "0.2.1",
  "identifier": "com.deproxy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeProxy",
        "width": 900,
        "height": 820,
        "minWidth": 700,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "Video",
    "shortDescription": "De-squeezed editing proxies for Apple silicon.",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
